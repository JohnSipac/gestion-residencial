<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" stylesheets="@../css/casa-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.fammateam.gestionresidencial.controller.CasaController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            
            <!-- TOP: Banner / Título -->
            <top>
                <AnchorPane styleClass="banner-container" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                    <children>
                        <Label layoutX="15.0" layoutY="12.0" styleClass="title-primary" text="Gestión de Casas" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="10.0" />
                    </children>
                    <BorderPane.margin>
                        <Insets bottom="10.0" />
                    </BorderPane.margin>
                </AnchorPane>
            </top>
            
            <!-- LEFT: Menú Lateral / Sidebar -->
            <left>
                <VBox fx:id="sidebar" spacing="8.0" styleClass="bar-container" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="15.0" left="8.0" right="8.0" top="15.0" />
                    </padding>
                    <BorderPane.margin>
                        <Insets right="10.0" />
                    </BorderPane.margin>
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleGoToMainMenu" styleClass="button-secundary">
                            <tooltip><Tooltip text="Menú Principal" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/menu-principal.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Casas" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/casas.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Residentes" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/residentes.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Casa de Residente" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/casa-residente.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Áreas Comunes" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/areas-comunes.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Reservas" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/reservas.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Pagos" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/pagos.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button mnemonicParsing="false" styleClass="button-secundary">
                            <tooltip><Tooltip text="Cuotas" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/cuotas.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Region VBox.vgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleGoToLoginView" styleClass="button-secundary">
                            <tooltip><Tooltip text="Cerrar Sesión" /></tooltip>
                            <graphic>
                                <ImageView fitHeight="25.0" fitWidth="25.0">
                                    <image><Image url="@../images/cerrar-sesion.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </VBox>
            </left>
            
            <!-- CENTER: Tabla y Botones de Acción Principales -->
            <center>
                <VBox spacing="10.0" styleClass="card-container" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <BorderPane.margin>
                        <Insets right="10.0" />
                    </BorderPane.margin>
                    <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="subtitle" text="Casas" />
                        <TableView fx:id="tvCasas" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="tvColumnIdCondominio" prefWidth="166.0" text="Nombre del condominio" />
                            <TableColumn fx:id="tvColumnNumeroCasa" prefWidth="144.0" text="Numero de casa" />
                            <TableColumn fx:id="tvColumnAliquota" prefWidth="100.0" text="aliquota" />
                          </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleCreateCasa" styleClass="button-primary" text="Crear">
                                 <graphic>
                                    <ImageView fitHeight="16.0" fitWidth="16.0">
                                       <image><Image url="@../images/crear.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#handleUpdateCasa" styleClass="button-primary" text="Actualizar">
                                 <graphic>
                                    <ImageView fitHeight="16.0" fitWidth="16.0">
                                       <image><Image url="@../images/actualizar.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Region HBox.hgrow="ALWAYS" />
                              <Button mnemonicParsing="false" onAction="#handleDeleteCasa" styleClass="button-delete" text="Eliminar">
                                 <graphic>
                                    <ImageView fitHeight="16.0" fitWidth="16.0">
                                       <image><Image url="@../images/borrar.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>
                    </children>
                </VBox>
            </center>
            
            <!-- RIGHT: Panel de Formulario (Datos de la casa) -->
            <right>
                <VBox fx:id="panelDatos" prefWidth="280.0" spacing="10.0" styleClass="card-container" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="subtitle" text="Datos de la casa" />
                        
                        <Label text="Condominio" />
                        <ComboBox fx:id="cmbCondominio" maxWidth="1.7976931348623157E308" promptText="Seleccionar condominio" styleClass="custom-combo" stylesheets="@../css/casa-view.css" />
                        
                        <Label text="Numero de casa" />
                        <TextField fx:id="txtNumeroCasa" styleClass="text-field" />
                        
                        <Label text="Aliquota" />
                        <TextField fx:id="txtAliquota" styleClass="text-field" />
                        
                        <Region VBox.vgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleSaveCasa" styleClass="button-primary" text="Guardar" HBox.hgrow="ALWAYS">
                                 <graphic>
                                    <ImageView fitHeight="14.0" fitWidth="14.0">
                                       <image><Image url="@../images/guardar.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Button mnemonicParsing="false" onAction="#handleCancel" styleClass="button-delete" text="Cancelar" HBox.hgrow="ALWAYS">
                                 <graphic>
                                    <ImageView fitHeight="14.0" fitWidth="14.0">
                                       <image><Image url="@../images/cancelar.png" /></image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                           </children>
                        </HBox>
                    </children>
                </VBox>
            </right>

        </BorderPane>
    </children>
</AnchorPane>

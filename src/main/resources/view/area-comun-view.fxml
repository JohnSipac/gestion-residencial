                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#clearFields" prefHeight="30.0" prefWidth="100.0" styleClass="button-delete" stylesheets="@../css/area-comun-view.css" text="Limpiar" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>

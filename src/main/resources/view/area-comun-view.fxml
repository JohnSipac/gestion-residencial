                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </center>
            <right>
                <AnchorPane fx:id="formContainer" managed="true" prefWidth="287.0" visible="true" BorderPane.alignment="CENTER">

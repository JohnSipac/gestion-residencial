                    <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </padding>
                    <children>
                        <AnchorPane styleClass="banner-container" stylesheets="@../css/area-comun-view.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <Label layoutX="20.0" layoutY="16.0" styleClass="title-primary" stylesheets="@../css/area-comun-view.css" text="Gestión de Áreas Comunes" />
                            </children>
                        </AnchorPane>
                    </children>
                </AnchorPane>
            </top>
            <left>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" styleClass="root-container" stylesheets="@../css/main-menu-view.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.fammateam.gestionresidencial.controller.MainMenuController">

    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <left>
                <VBox fx:id="sidebarPane" alignment="TOP_CENTER" prefWidth="110.0" spacing="15.0" styleClass="sidebar-pane" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
                    </padding>
                    <children>
                        <StackPane maxHeight="85.0" maxWidth="85.0" minHeight="85.0" minWidth="85.0" prefHeight="85.0" prefWidth="85.0">
                            <children>
                                <Circle radius="42.0" styleClass="logo-circle-frame-small" />
                                <ImageView fx:id="imgLogo" fitHeight="80.0" fitWidth="80.0" pickOnBounds="false" preserveRatio="false">
                                    <image>
                                        <Image url="@../images/admin-residencial.jpg" />
                                    </image>
                                    <clip>
                                        <Circle centerX="40.0" centerY="40.0" radius="40.0" />
                                    </clip>
                                </ImageView>
                            </children>
                        </StackPane>

                        <Button fx:id="btnToggleMenu" mnemonicParsing="false" onAction="#toggleSidebar" styleClass="icon-button">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/left-and-right.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Menú / Desplegar" />
                            </tooltip>
                        </Button>
                        <Button fx:id="btnInicio" mnemonicParsing="false" styleClass="icon-button-active">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/home.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Inicio" />
                            </tooltip>
                        </Button>
                        <VBox VBox.vgrow="ALWAYS" />
                        <Button cancelButton="true" mnemonicParsing="false" onAction="#backToLogin" styleClass="icon-button-logout">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/back.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <tooltip>
                                <Tooltip text="Cerrar Sesión" />
                            </tooltip>
                        </Button>
                    </children>
                </VBox>
            </left>
            <center>
                <VBox spacing="15.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="85.0" spacing="15.0" styleClass="header-card">
                            <padding>
                                <Insets left="30.0" right="30.0" />
                            </padding>
                            <children>
                                <VBox alignment="CENTER_LEFT" spacing="3.0">
                                    <children>
                                        <Label styleClass="header-greeting" text="Bienvenido de nuevo," />
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblUsername" styleClass="header-username" text="USUARIO" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>  
                        <VBox fx:id="contentArea" styleClass="main-content-card" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                            </padding>
                            <children>
                                <Label styleClass="title-sub-primary" text="Panel de Control" />
                                <FlowPane hgap="20.0" prefHeight="381.0" prefWidth="700.0" vgap="20.0">
                                   <children>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleAreaComun" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="ÁREAS COMUNES">
                                         <graphic>
                                            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                                               <image>
                                                  <Image url="@../images/areas-comunes.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleCondominio" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="CONDOMINIOS">
                                         <graphic>
                                            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                                               <image>
                                                  <Image url="@../images/condominio.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleResidentes" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="RESIDENTES">
                                         <graphic>
                                            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                                               <image>
                                                  <Image url="@../images/residentes.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleCasa" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="CASAS">
                                         <graphic>
                                            <ImageView fitHeight="71.0" fitWidth="75.0">
                                               <image>
                                                  <Image url="@../images/casas.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleCuotas" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="CUOTAS">
                                         <graphic>
                                            <ImageView fitHeight="66.0" fitWidth="63.0">
                                               <image>
                                                  <Image url="@../images/cuotas.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                                      <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleCasaResidente" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="ASIGNAR CASAS">
                                         <graphic>
                                            <ImageView fitHeight="55.0" fitWidth="61.0">
                                               <image>
                                                  <Image url="@../images/casa-residente.png" />
                                               </image>
                                            </ImageView>
                                         </graphic>
                                      </Button>
                              <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleGoToReserva" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="RESERVAS">
                                 <graphic>
                                    <ImageView fitHeight="74.0" fitWidth="75.0">
                                       <image>
                                          <Image url="@../images/reservas.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                              <Button contentDisplay="TOP" graphicTextGap="10.0" mnemonicParsing="false" onAction="#handleGoToPagoView" prefHeight="130.0" prefWidth="170.0" style="-fx-font-family: 'Segoe UI'; -fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #FFFFFF;" styleClass="icon-button-active" stylesheets="@../css/main-menu-view.css" text="PAGOS">
                                 <graphic>
                                    <ImageView fitHeight="79.0" fitWidth="88.0">
                                       <image>
                                          <Image url="@../images/pagos.png" />
                                       </image>
                                    </ImageView>
                                 </graphic>
                              </Button>
                                   </children>
                                   <padding>
                                      <Insets top="20.0" />
                                   </padding>
                                </FlowPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>
